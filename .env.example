# Copy this file to ".env" and adjust. Never commit the real .env file.

# --- Core ---
DJANGO_DEBUG=False
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
DJANGO_TIME_ZONE=Asia/Kolkata

# --- Database ---
# Leave unset to use SQLite (db.sqlite3 in the project root).
# DATABASE_URL=postgres://user:password@localhost:5432/releaf

# --- CORS / CSRF (needed for web clients; native mobile apps do not use CORS) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# CORS_ALLOW_ALL_ORIGINS=False
# CSRF_TRUSTED_ORIGINS=https://api.example.com

# --- JWT ---
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30

# --- Open-Meteo ---
OPEN_METEO_TIMEOUT=8
AQI_CACHE_SECONDS=600
AQI_CHALLENGE_THRESHOLD=100

# --- Gamification / proof rules ---
PROOF_MAX_SIZE_MB=5
PROOF_MIN_DIMENSION=200
PROOF_AUTO_APPROVE=True
MAX_ACTIONS_PER_DAY=5

# --- Throttling ---
THROTTLE_ANON=60/min
THROTTLE_USER=300/min
THROTTLE_AUTH=10/min
THROTTLE_SUBMIT=30/hour

# --- Optional: shared cache (recommended with several gunicorn workers) ---
# REDIS_URL=redis://localhost:6379/1

# --- Production hardening (only when DJANGO_DEBUG=False) ---
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
